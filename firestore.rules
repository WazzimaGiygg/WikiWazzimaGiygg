rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.size() > 0;
    }

    function isValidPage(data) {
      return data.slug is string && data.slug.size() <= 200
        && data.title is string && data.title.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRevision(data) {
      return data.revId is string && data.revId.size() <= 128
        && data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRecentChange(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.author is string && data.author.size() <= 100;
    }

    function isValidTalk(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.topicTitle is string && data.topicTitle.size() <= 250
        && data.content is string && data.content.size() <= 50000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidSettings(data) {
      return data.sitename is string && data.sitename.size() <= 100
        && data.languageCode is string && data.languageCode.size() <= 10;
    }

    // Wiki Pages collection
    match /wiki_pages/{pageId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPage(request.resource.data);
      allow update: if isSignedIn() && isValidPage(request.resource.data);
      allow delete: if isSignedIn();

      // Revisions subcollection (immutable, authenticated only)
      match /revisions/{revId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidRevision(request.resource.data);
        allow update: if false; // Revisions are immutable
        allow delete: if isSignedIn();
      }

      // Talks subcollection (discussion comments, authenticated only)
      match /talks/{talkId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidTalk(request.resource.data);
        allow update: if isSignedIn() && isValidTalk(request.resource.data);
        allow delete: if isSignedIn();
      }
    }

    // Recent changes log (authenticated only)
    match /recent_changes/{changeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidRecentChange(request.resource.data);
      allow update: if false; // Recent change log is append-only
      allow delete: if isSignedIn();
    }

    function isValidExtension(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000;
    }

    // Wiki settings configuration (authenticated only)
    match /wiki_settings/{settingId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidSettings(request.resource.data);
      allow delete: if isSignedIn();
    }

    // User roles / permissions
    match /user_roles/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bureaucrat logs
    match /bureaucrat_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Page protection logs
    match /page_protection_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Wiki extensions (synchronized with codebase & Firestore, managed by bureaucrats)
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidExtension(request.resource.data);
      allow delete: if isSignedIn();
    }

    // CheckUser / Sockpuppet cases
    match /checkuser_cases/{caseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Unblock discussion requests
    match /unblock_requests/{requestId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Arbitration Committee (ArbCom) cases
    match /arbcom_cases/{caseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Universal Code of Conduct (UCoC) reports
    match /ucoc_reports/{reportId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
